// =============================================================================
// DSC Datathon - database schema
//
// Sections
//   1. Identity       User
//   2. Academic       School, AcademicProgram, AcademicInformation
//   3. Registration   Registration (per-datathon answers)
//   4. Teams          Team, TeamMember, Deliverable
//
// How the pieces connect
//   auth.users (Supabase, not modelled here)
//        | 0..1  users.auth_user_id
//        v
//      User --1:1-- AcademicInformation --N:1-- School
//        |                    '-----------N:1-- AcademicProgram
//        |--1:1-- Registration
//        |--1:1-- TeamMember --N:1-- Team --1:N-- Deliverable
//        '--1:N-- Team (as leader, via Team.leaderId)
//
// Rules that live in the database, not in this file (see migrations/)
//   - Team size is 1-4 and the leader must be a member (deferred trigger
//     validate_team_membership).
//   - A private team must have a join code (CHECK on teams).
//   - Registration answers must be consistent (CHECKs on registrations).
//   - AcademicInformation needs exactly one of programId/programOther and at
//     least one of schoolId/schoolOther (CHECKs).
//   - Row Level Security on every table; teams and team_members are written
//     only through the create_team / join_* functions.
//
// Conventions: snake_case in the database (@map / @@map), camelCase here;
// UUID primary keys generated by Postgres; every table is in "public".
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth"]
}

//
//  Identity
//

enum Gender {
  male
  female
  non_binary
  prefer_not_to_say
  other

  @@schema("public")
}

/// Reusable profile of a person. Datathon-specific answers live in Registration.
model User {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Link to Supabase Auth (auth.users.id). Null until the person signs up.
  authUserId String? @unique @map("auth_user_id") @db.Uuid

  // Basic data
  name      String    @db.VarChar(100)
  lastName  String    @map("last_name") @db.VarChar(100)
  username  String    @unique @db.VarChar(32)
  email     String    @unique @db.VarChar(320)
  gender    Gender
  phone     String?   @db.VarChar(20)
  birthDate DateTime? @map("birth_date") @db.Date

  // Public profile and links
  profileImg   String? @map("profile_img")
  githubUrl    String? @map("github_url")
  linkedinUrl  String? @map("linkedin_url")
  devpostUrl   String? @map("devpost_url")
  cvUrl        String? @map("cv_url")
  portfolioUrl String? @map("portfolio_url")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  academicInformation AcademicInformation?
  registration        Registration?
  teamMemberships     TeamMember[]
  ledTeams            Team[]               @relation("TeamLeader")

  @@map("users")
  @@schema("public")
}

// 
// ACADEMIC
// 

enum ProgramLevel {
  undergraduate
  postgraduate

  @@schema("public")
}

enum AcademicLevel {
  freshman
  sophomore
  junior
  senior
  graduate
  masters
  doctorate
  other

  @@schema("public")
}

/// Catalog: universities (TEC, UANL, ...).
model School {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(150)
  shortName String?  @unique @map("short_name") @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  academicInformation AcademicInformation[]

  @@map("schools")
  @@schema("public")
}

/// Catalog: carreras and postgrados. `level` tells them apart in the form.
model AcademicProgram {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String       @db.VarChar(20)
  name        String       @db.VarChar(150)
  institution String       @db.VarChar(150)
  level       ProgramLevel @default(undergraduate)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamp(6)

  academicInformation AcademicInformation[]

  @@unique([institution, code])
  @@map("academic_programs")
  @@schema("public")
}

/// What one user studies. The primary key is the user (strictly 1:1).
/// School and program are either a catalog id or free text ("...Other").
model AcademicInformation {
  userId                 String        @id @map("user_id") @db.Uuid
  academicLevel          AcademicLevel @map("academic_level")
  expectedGraduationDate DateTime?     @map("expected_graduation_date") @db.Date

  // School: catalog id OR free text (at least one, enforced by CHECK)
  schoolId    String? @map("school_id") @db.Uuid
  schoolOther String? @map("school_other") @db.VarChar(150)

  // Program: catalog id XOR free text (exactly one, enforced by CHECK)
  programId    String? @map("program_id") @db.Uuid
  programOther String? @map("program_other") @db.VarChar(150)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  school  School?          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  program AcademicProgram? @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@map("academic_information")
  @@schema("public")
}

//
// REGISTRATION
// Answers to the inscription form that are specific to this datathon.
// Keyed by user (1:1) for now; add a datathon id to the key for future editions.

enum TeamPreference {
  has_team // "Si": already has a team, enters its code
  looking // "Sigo buscando uno": gives an interest area
  create_team // "Quiero crear un equipo"
  skip // "Omitir"

  @@schema("public")
}

model Registration {
  userId String @id @map("user_id") @db.Uuid

  // Hackathon history (CHECKs: count >= 0; count and wins need experience)
  hasHackathonExperience Boolean @map("has_hackathon_experience")
  hackathonCount         Int     @default(0) @map("hackathon_count")
  hasWonHackathon        Boolean @default(false) @map("has_won_hackathon")

  // Skills
  hasProgrammingExperience  Boolean @map("has_programming_experience")
  hasDataScienceExperience  Boolean @map("has_data_science_experience")
  hasSystemDesignExperience Boolean @map("has_system_design_experience")

  // Team intent (CHECK: interestArea only when teamPreference = looking)
  teamPreference TeamPreference @map("team_preference")
  interestArea   String?        @map("interest_area") @db.VarChar(150)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("registrations")
  @@schema("public")
}

//
// TEAMS
// Created and joined only through database functions (create_team,
// join_team_by_code, join_public_team); direct writes are blocked by RLS.
//

enum TeamVisibility {
  public // listed for everyone
  private // joined only with `code`

  @@schema("public")
}

model Team {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String         @db.VarChar(80)
  slug       String         @unique @db.VarChar(80)
  visibility TeamVisibility @default(public)
  /// Join code. Required when private (CHECK); only members can read it.
  code       String?        @unique @db.VarChar(8)
  leaderId   String         @map("leader_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamp(6)

  leader       User          @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Restrict)
  members      TeamMember[]
  deliverables Deliverable[]

  @@map("teams")
  @@schema("public")
}

/// Join table. `userId` is unique, so a person is in at most one team.
/// The trigger keeps teams at 1-4 members and the leader among them.
model TeamMember {
  teamId   String   @map("team_id") @db.Uuid
  userId   String   @unique @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamp(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
  @@schema("public")
}

/// Entregables of a team.
model Deliverable {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId      String    @map("team_id") @db.Uuid
  title       String    @db.VarChar(150)
  url         String
  submittedAt DateTime? @map("submitted_at") @db.Timestamp(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("deliverables")
  @@schema("public")
}
