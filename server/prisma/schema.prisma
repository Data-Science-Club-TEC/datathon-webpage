generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth"]
}

enum Gender {
  male
  female
  non_binary
  prefer_not_to_say
  other

  @@schema("public")
}

model User {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId          String?              @unique @map("auth_user_id") @db.Uuid
  name                String               @db.VarChar(100)
  lastName            String               @map("last_name") @db.VarChar(100)
  username            String               @unique @db.VarChar(32)
  email               String               @unique @db.VarChar(320)
  gender              Gender
  profileImg          String?              @map("profile_img")
  githubUrl           String?              @map("github_url")
  linkedinUrl         String?              @map("linkedin_url")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamp(6)
  academicInformation AcademicInformation?
  teamMemberships     TeamMember[]
  ledTeams            Team[]               @relation("TeamLeader")

  @@map("users")
  @@schema("public")
}

model AcademicProgram {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String                @db.VarChar(20)
  name                String                @db.VarChar(150)
  institution         String                @db.VarChar(150)
  isActive            Boolean               @default(true) @map("is_active")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamp(6)
  academicInformation AcademicInformation[]

  @@unique([institution, code])
  @@map("academic_programs")
  @@schema("public")
}

model School {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String                @unique @db.VarChar(150)
  shortName           String?               @unique @map("short_name") @db.VarChar(50)
  isActive            Boolean               @default(true) @map("is_active")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamp(6)
  academicInformation AcademicInformation[]

  @@map("schools")
  @@schema("public")
}

enum AcademicLevel {
  freshman
  sophomore
  junior
  senior
  graduate
  other

  @@schema("public")
}

model AcademicInformation {
  userId                 String           @id @map("user_id") @db.Uuid
  programId              String?          @map("program_id") @db.Uuid
  programOther           String?          @map("program_other") @db.VarChar(150)
  academicLevel          AcademicLevel    @map("academic_level")
  expectedGraduationDate DateTime?        @map("expected_graduation_date") @db.Date
  schoolId               String?          @map("school_id") @db.Uuid
  schoolOther            String?          @map("school_other") @db.VarChar(150)
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamp(6)
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  program                AcademicProgram? @relation(fields: [programId], references: [id], onDelete: Restrict)
  school                 School?          @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@map("academic_information")
  @@schema("public")
}

model Team {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String       @db.VarChar(80)
  slug      String       @unique @db.VarChar(80)
  leaderId  String       @map("leader_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamp(6)
  leader    User         @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Restrict)
  members   TeamMember[]

  @@map("teams")
  @@schema("public")
}

model TeamMember {
  teamId   String   @map("team_id") @db.Uuid
  userId   String   @unique @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamp(6)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
  @@schema("public")
}
